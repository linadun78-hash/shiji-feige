{
  "manifest_version": 3,
  "name": "拾集 · 飞鸽",
  "version": "0.4.0",
  "key": "",
  "description": "拾取网页材料，为每条材料设置目的、指令和回复语言，整理后发送至本地 Agent 服务。",
  "permissions": ["activeTab", "scripting", "clipboardWrite", "storage", "nativeMessaging"],
  "icons": {"16":"icons/16.png", "32":"icons/32.png", "48":"icons/48.png", "128":"icons/128.png"},
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "src/background.js"},
  "action": {"default_title": "在当前页面启用拾集 · 飞鸽", "default_icon":{"16":"icons/16.png", "32":"icons/32.png", "48":"icons/48.png"}}
}
